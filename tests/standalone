#!/usr/bin/env bash
set -euo pipefail
repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
cp -a "$repo_dir/editor" "$scratch/editor"
export XDG_CONFIG_HOME="$scratch/config"
"$scratch/editor/scripts/bootstrap" --copy
# Moving the installers must not break a copied configuration.
mv "$scratch/editor" "$scratch/moved-editor"
[[ ! -L "$XDG_CONFIG_HOME/${NVIM_APPNAME:-nvim}" ]]
"$repo_dir/tests/check-editors"
printf 'PASS standalone editor moved; copied config works\n'
