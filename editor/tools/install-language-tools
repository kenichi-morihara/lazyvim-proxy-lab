#!/usr/bin/env python3
import os
import shutil
from common import TOOLS, PREFIX, VERSIONS, run

npm = PREFIX / "share/editor-tools/npm"
npm.mkdir(parents=True, exist_ok=True)
for name in ("package.json", "package-lock.json"):
    shutil.copy2(TOOLS / name, npm / name)
run("npm", "ci", "--prefix", npm, "--no-audit", "--no-fund")
venv = PREFIX / "share/editor-tools/python"
run(os.environ.get("PYTHON", "python3"), "-m", "venv", venv)
run(venv / "bin/python", "-m", "pip", "install", "--only-binary=:all:", "--require-hashes", "-r", TOOLS / "requirements.lock")
bindir = PREFIX / "bin"
bindir.mkdir(parents=True, exist_ok=True)
for name in ("basedpyright", "basedpyright-langserver", "vtsls", "tsc", "prettier", "ruff"):
    source = (venv / "bin/ruff") if name == "ruff" else (npm / "node_modules/.bin" / name)
    dest = bindir / name
    if dest.is_symlink() and dest.resolve() == source.resolve():
        continue
    if dest.exists() or dest.is_symlink():
        raise SystemExit(f"Refusing to overwrite existing executable: {dest}")
    dest.symlink_to(source)
print(f"Add {bindir} to PATH")
