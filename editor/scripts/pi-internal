#!/usr/bin/env python3
# proxy-lab managed internal Pi launcher
"""Launch pinned Pi with an isolated internal provider and no startup downloads."""
import json
import os
from pathlib import Path
import shutil
import re
import runpy
import subprocess
import sys
import tempfile
from urllib.parse import urlsplit


def main():
    prefix = Path(__file__).resolve().parent.parent
    cli = prefix / "share/editor-pi/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js"
    if not cli.is_file() or not shutil.which("node"):
        raise ValueError("Pi is missing. Run make setup-pi and make Node.js available on PATH.")
    env = dict(os.environ, PI_OFFLINE="1", PI_SKIP_VERSION_CHECK="1", PI_TELEMETRY="0")
    if sys.argv[1:] in (["--version"], ["--help"], ["-h"]):
        return subprocess.call(["node", str(cli), *sys.argv[1:]], env=env)
    settings = runpy.run_path(str(prefix / "share/editor-pi/company/local_config.py"))
    env = settings["load_config"](env)
    transport = env.get("INTERNAL_AI_TRANSPORT", "openai")
    if transport not in ("openai", "company-chat"):
        raise ValueError("INTERNAL_AI_TRANSPORT must be openai or company-chat.")
    env["OPENAI_LOG"] = "off"  # SDK diagnostics must not print private headers or payloads.
    if sys.argv[1:] == ["--doctor"]:
        return subprocess.call(["node", str(prefix / "share/editor-pi/company/doctor.mjs")], env=env)
    required = (("INTERNAL_AI_ENDPOINT", "INTERNAL_AI_COOKIE_FILE") if transport == "company-chat" else
                ("INTERNAL_AI_BASE_URL", "INTERNAL_AI_MODEL"))
    missing = [name for name in required if not env.get(name)]
    if missing:
        raise ValueError("Set " + ", ".join(missing) + ". See editor/AI-SETUP.md.")
    if transport == "company-chat":
        # Validate locally before entering the TUI; no network request.
        check = subprocess.run(["node", str(prefix / "share/editor-pi/company/doctor.mjs"), "--check-only"], env=env)
        if check.returncode:
            return check.returncode
    if transport == "openai":
        user_header = env.get("INTERNAL_AI_USER_HEADER", "user")
        user = env.get("INTERNAL_AI_USER", "")
        if not env.get("INTERNAL_AI_API_KEY") and not user:
            raise ValueError("Set INTERNAL_AI_API_KEY or INTERNAL_AI_USER.")
        if user:
            if not re.fullmatch(r"[A-Za-z0-9-]+", user_header) or user_header.lower() in (
                "authorization", "host", "content-type", "content-length", "connection", "transfer-encoding"
            ):
                raise ValueError("INTERNAL_AI_USER_HEADER must be a separate user header name.")
            if any(ord(char) < 32 or ord(char) == 127 for char in user):
                raise ValueError("INTERNAL_AI_USER contains invalid header characters.")
        env["OPENAI_LOG"] = "off"
    provider = None
    if transport == "openai":
        url = urlsplit(env["INTERNAL_AI_BASE_URL"])
        if url.scheme not in ("https", "http") or not url.hostname or url.username or url.password or url.query or url.fragment:
            raise ValueError("INTERNAL_AI_BASE_URL must be an HTTP(S) base URL without credentials, query or fragment.")
        if url.scheme == "http" and url.hostname not in ("localhost", "127.0.0.1", "::1"):
            raise ValueError("Use HTTPS for the internal AI; HTTP is allowed only for localhost tests.")
        api = env.get("INTERNAL_AI_API", "openai-responses")
        if api not in ("openai-completions", "openai-responses"):
            raise ValueError("INTERNAL_AI_API must be openai-completions or openai-responses.")
        if not env.get("INTERNAL_AI_API_KEY") and api != "openai-responses":
            raise ValueError("User-header-only authentication requires openai-responses.")
        header = env.get("INTERNAL_AI_AUTH_HEADER", "Authorization")
        provider = {"baseUrl": env["INTERNAL_AI_BASE_URL"], "api": api,
                    "apiKey": "${INTERNAL_AI_API_KEY}" if env.get("INTERNAL_AI_API_KEY") else "unused",
                    "authHeader": bool(env.get("INTERNAL_AI_API_KEY")) and header.lower() == "authorization",
                    "models": [{"id": env["INTERNAL_AI_MODEL"], "input": ["text"], "reasoning": False}]}
        if env.get("INTERNAL_AI_API_KEY") and header.lower() != "authorization":
            if not header or any(not (char.isascii() and (char.isalnum() or char == "-")) for char in header):
                raise ValueError("INTERNAL_AI_AUTH_HEADER must be a valid header name.")
            provider["headers"] = {header: "${INTERNAL_AI_API_KEY}"}
        if user:
            if header.lower() == user_header.lower() and env.get("INTERNAL_AI_API_KEY"):
                raise ValueError("User and API key headers must have different names.")
            provider.setdefault("headers", {})[user_header] = "${INTERNAL_AI_USER}"
    # Runtime config contains no literal API key, and is separate from ~/.pi/agent.
    # One temporary config per process avoids clashes between concurrent sessions.
    state = Path(env.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "editor-pi"
    os.umask(0o077)
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    state.chmod(0o700)
    sessions = state / "sessions"
    sessions.mkdir(exist_ok=True, mode=0o700)
    with tempfile.TemporaryDirectory(prefix="runtime-", dir=state) as directory:
        config = Path(directory)
        (config / "models.json").write_text(json.dumps({"providers": {"internal": provider} if transport == "openai" else {}}))
        (config / "settings.json").write_text(json.dumps({"enableInstallTelemetry": False, "enableAnalytics": False}))
        env["PI_CODING_AGENT_DIR"] = directory
        model = env.get("INTERNAL_AI_MODEL", "company-chat")
        command = ["node", str(cli), *sys.argv[1:], "--provider", "internal", "--model", model,
                   "--models", "internal/" + model, "--offline", "--no-extensions",
                   "--session-dir", str(sessions)]
        if transport == "company-chat":
            command += ["-e", str(prefix / "share/editor-pi/company/company-provider.mjs")]
        if transport == "openai" and user and api == "openai-responses":
            command += ["-e", str(prefix / "share/editor-pi/company/responses-provider.mjs")]
        return subprocess.call(command, env=env)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print("ERROR: " + str(error), file=sys.stderr)
        sys.exit(1)
