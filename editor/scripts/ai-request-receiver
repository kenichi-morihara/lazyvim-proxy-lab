#!/usr/bin/env python3
"""Receive dummy API examples locally; no upstream AI calls or header capture."""
import argparse
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
from pathlib import Path
import re
import secrets
import threading
from urllib.parse import urlsplit

MAX_BYTES = 256 * 1024
SECRET_FIELD = re.compile(r"^(authorization|proxy.authorization|cookie|set.cookie|.*api.?key|.*token|.*password|.*secret)$", re.I)


def redact(value):
    if isinstance(value, dict):
        return {key: "[REDACTED]" if SECRET_FIELD.fullmatch(key) else redact(item)
                for key, item in value.items()}
    if isinstance(value, list):
        return [redact(item) for item in value]
    return value


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int, default=8765)
    parser.add_argument("--state-dir", type=Path, default=Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "editor-ai-capture")
    args = parser.parse_args()
    os.umask(0o077)
    state = args.state_dir.expanduser().resolve()
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    state.chmod(0o700)
    token = secrets.token_urlsafe(32)
    count = 0
    lock = threading.Lock()

    class Handler(BaseHTTPRequestHandler):
        def setup(self):
            super().setup()
            self.connection.settimeout(10)

        def log_message(self, *_):
            pass  # Never log URLs (capability token), headers, or request bodies.

        def reply(self, status, value):
            payload = json.dumps(value).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)

        def do_GET(self):
            self.reply(200 if self.path == "/health" else 404,
                       {"status": "ready"} if self.path == "/health" else {"error": "not found"})

        def do_POST(self):
            nonlocal count
            parts = urlsplit(self.path).path.split("/")
            if len(parts) < 3 or parts[1] != "capture" or not secrets.compare_digest(parts[2], token):
                return self.reply(404, {"error": "not found"})
            if self.headers.get_content_type() != "application/json":
                return self.reply(415, {"error": "application/json required"})
            try:
                length = int(self.headers.get("Content-Length", "0"))
            except ValueError:
                length = 0
            if not 0 < length <= MAX_BYTES or self.headers.get("Transfer-Encoding"):
                return self.reply(413, {"error": "JSON body must be 1..262144 bytes; Content-Length required"})
            try:
                raw = self.rfile.read(length)
                if len(raw) != length:
                    raise ValueError("incomplete body")
                body = json.loads(raw)
                if not isinstance(body, (dict, list)):
                    raise ValueError("object or array required")
                body = redact(body)
            except (ValueError, UnicodeError, RecursionError):
                return self.reply(400, {"error": "valid JSON object or array required"})
            with lock:
                if count >= 20:
                    return self.reply(429, {"error": "capture limit reached; restart receiver"})
                receipt = secrets.token_hex(8)
                record = {"received_at": datetime.now(timezone.utc).isoformat(), "body": body}
                with (state / (receipt + ".json")).open("x", encoding="utf-8") as output:
                    json.dump(record, output, ensure_ascii=False, indent=2)
                count += 1
            print("Received " + receipt, flush=True)
            self.reply(201, {"received": receipt, "note": "Example captured; no AI request was made."})

    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    print(f"Listening http://127.0.0.1:{server.server_port}/capture/{token}", flush=True)
    print(f"Private captures: {state}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
