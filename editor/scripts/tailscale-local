#!/usr/bin/env python3
"""Optional per-user userspace daemon; no sudo, TUN device, or system service."""
import fcntl
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time


def locations():
    state = Path(os.environ.get("EDITOR_TAILSCALE_STATE_DIR") or
                 Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "editor-tailscale")
    socket = Path(os.environ.get("EDITOR_TAILSCALE_SOCKET") or state / "tailscaled.sock")
    return state.expanduser().resolve(), socket.expanduser().resolve()


def ready(cli, socket):
    if not socket.exists():
        return False
    try:
        result = subprocess.run([cli, "--socket=" + str(socket), "status", "--json"],
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=3)
        # NeedsLogin may return nonzero while the daemon is healthy.
        data = json.loads(result.stdout)
        return isinstance(data, dict) and isinstance(data.get("BackendState"), str)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return False


def start(cli, state, socket):
    daemon = shutil.which("tailscaled")
    if not daemon:
        raise RuntimeError("tailscaled is not on PATH. Install the optional Tailscale OS package first.")
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    state.chmod(0o700)
    # Keep socket access and credentials inside a user-owned private directory.
    socket.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock_fd = os.open(state / "start.lock", os.O_CREAT | os.O_RDWR, 0o600)
    with os.fdopen(lock_fd, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if ready(cli, socket):
            print("Reusing the user Tailscale daemon.")
            return
        log_fd = os.open(state / "tailscaled.log", os.O_CREAT | os.O_WRONLY | os.O_APPEND, 0o600)
        with os.fdopen(log_fd, "a") as log:
            process = subprocess.Popen(
                [daemon, "--tun=userspace-networking", "--port=0", "--socket=" + str(socket),
                 "--state=" + str(state / "tailscaled.state")],
                stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                start_new_session=True, close_fds=True)
        for _ in range(50):
            if process.poll() is not None:
                raise RuntimeError("tailscaled exited. Read the private log: " + str(state / "tailscaled.log"))
            if ready(cli, socket):
                print("User Tailscale daemon started (userspace networking).")
                print("Next: " + str(Path(__file__).resolve()) + " up --accept-dns=false")
                return
            time.sleep(0.1)
        process.terminate()
        raise RuntimeError("tailscaled did not become ready. Read: " + str(state / "tailscaled.log"))


def main():
    if len(sys.argv) < 2:
        print("Usage: tailscale-local start | <tailscale command ...>\n"
              "Example: tailscale-local up --accept-dns=false")
        return 0
    cli = shutil.which("tailscale")
    if not cli:
        raise RuntimeError("tailscale is not on PATH. Install the optional Tailscale OS package first.")
    state, socket = locations()
    if sys.argv[1] == "start":
        if len(sys.argv) != 2:
            raise RuntimeError("start does not accept arguments; use environment settings for state/socket paths.")
        start(cli, state, socket)
        return 0
    os.execv(cli, [cli, "--socket=" + str(socket), *sys.argv[1:]])


if __name__ == "__main__":
    os.umask(0o077)
    try:
        sys.exit(main())
    except (OSError, RuntimeError) as error:
        print("ERROR: " + str(error), file=sys.stderr)
        sys.exit(1)
