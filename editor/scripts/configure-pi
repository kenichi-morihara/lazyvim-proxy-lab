#!/usr/bin/env python3
"""Interactively configure Responses without placing secrets in shell history."""
import getpass
import os
from pathlib import Path
import re
import subprocess
import sys
from urllib.parse import urlsplit

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'pi'))
from local_config import read_config, save_config


class SetupError(ValueError):
    """An actionable message that contains no entered configuration values."""


def main():
    if not sys.stdin.isatty():
        raise SetupError('Run make configure-pi in an interactive terminal.')
    env = dict(os.environ)
    try:
        saved = read_config(env)
    except ValueError as error:
        raise SetupError(str(error)) from None
    print('Pi Responses setup. Secret inputs are hidden. Enter keeps saved values.')
    def ask(label, key, default='', secret=False):
        previous = saved.get(key, env.get(key, default))
        prompt = label + (' [saved/default]' if secret and previous else f' [{previous}]' if previous else '') + ': '
        value = getpass.getpass(prompt) if secret else input(prompt)
        return value if value else previous
    print('Base URL example: https://ai.example/v1')
    print('If the endpoint is https://ai.example/v1/responses, enter https://ai.example/v1.')
    print('Keep any service-specific path prefix; omit only the final /responses. No default URL is selected.')
    base = ask('API base URL (example: https://ai.example/v1)', 'INTERNAL_AI_BASE_URL').rstrip('/')
    url = urlsplit(base)
    if url.scheme not in ('https', 'http') or not url.hostname or url.username or url.password or url.query or url.fragment:
        raise SetupError('Enter a base URL without credentials, query or fragment.')
    allow_http = False
    if url.scheme == 'http' and url.hostname not in ('localhost', '127.0.0.1', '::1'):
        print('HTTP sends the user header and Bearer token without TLS encryption.')
        allow_http = input('Allow HTTP for this internal endpoint? [y/N]: ').strip().lower() in ('y', 'yes')
        if not allow_http:
            raise SetupError('HTTP was not enabled. Use HTTPS or explicitly allow the internal HTTP endpoint.')
    if url.path.endswith(('/responses', '/chat/completions')):
        raise SetupError('Enter the base URL without /responses or /chat/completions.')
    model = ask('Model', 'INTERNAL_AI_MODEL', 'gpt-6.1-sol')
    header = ask('User header name', 'INTERNAL_AI_USER_HEADER', 'user')
    if not re.fullmatch(r'[A-Za-z0-9-]+', header) or header.lower() in (
        'authorization', 'host', 'content-type', 'content-length', 'connection', 'transfer-encoding'
    ):
        raise SetupError('Enter a separate user header name.')
    user = ask('User header value', 'INTERNAL_AI_USER', secret=True)
    token = ask('Bearer token (without Bearer prefix)', 'INTERNAL_AI_API_KEY', secret=True)
    if token.lower().startswith('bearer '):
        token = token[7:].strip()
    if not model or not user or not token or any(ord(c) < 32 or ord(c) == 127 for c in user + token):
        raise SetupError('Model, user and Bearer token are required; control characters are forbidden.')
    data = dict(INTERNAL_AI_TRANSPORT='openai', INTERNAL_AI_API='openai-responses',
                INTERNAL_AI_BASE_URL=base, INTERNAL_AI_MODEL=model,
                INTERNAL_AI_USER_HEADER=header, INTERNAL_AI_USER=user,
                INTERNAL_AI_API_KEY=token, INTERNAL_AI_AUTH_HEADER='Authorization')
    if allow_http:
        data['INTERNAL_AI_ALLOW_HTTP'] = '1'
    print('Optional network settings. Enter inherits the environment unless a saved value exists; - clears a saved value.')
    for label, key in [('HTTPS proxy', 'HTTPS_PROXY'), ('HTTP proxy', 'HTTP_PROXY'),
                       ('No-proxy hosts', 'NO_PROXY'), ('Additional CA PEM file', 'NODE_EXTRA_CA_CERTS')]:
        value = ask(label, key, secret=key.endswith('PROXY') and key != 'NO_PROXY')
        if value and value != '-':
            if key == 'NODE_EXTRA_CA_CERTS' and not Path(value).expanduser().is_file():
                raise SetupError('Additional CA file does not exist.')
            data[key] = str(Path(value).expanduser()) if key == 'NODE_EXTRA_CA_CERTS' else value
    try:
        save_config(env, data)
    except ValueError as error:
        raise SetupError(str(error)) from None
    print('Saved private connection settings (directory 700, file 600). No network request sent.')
    prefix = Path(env.get('EDITOR_PREFIX') or Path.home() / '.local').expanduser()
    command = prefix / 'bin/pi'
    print('Start Pi with: ' + str(command) + ' (or add this bin directory to PATH).')
    if command.is_file():
        check_env = {k: v for k, v in env.items() if not k.startswith('INTERNAL_AI_')}
        return subprocess.call([str(command), '--doctor'], env=check_env)
    print('Run make setup-pi, then make doctor-pi. Add the prefix bin directory to PATH if needed.')
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except SetupError as error:
        print('Pi setup: ' + str(error), file=sys.stderr)
        raise SystemExit(1)
    except OSError as error:
        print(f'Pi setup: local file/command operation failed (errno={error.errno}). Check configuration directory permissions and the Pi installation.', file=sys.stderr)
        raise SystemExit(1)
    except ValueError:
        print('Pi setup: invalid URL or setting format. Rerun make configure-pi.', file=sys.stderr)
        raise SystemExit(1)
    except (EOFError, KeyboardInterrupt):
        print('Pi setup: input cancelled. Rerun make configure-pi in an interactive terminal.', file=sys.stderr)
        raise SystemExit(1)
